# Set these to the numeric owner/group IDs of the host user that owns
# Server/ and Data/ (normally the output of: id -u and id -g).
SERVER_UID=1000
SERVER_GID=1000

# URL of the server ZIP archive downloaded by Server/install.sh on first start.
# Change this only when mirroring the server distribution elsewhere.
VINTAGESTORY_ARCHIVE_URL=
