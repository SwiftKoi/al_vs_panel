{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Remote": {
    "Targets": {
      "demo-local-host": {
        "Mode": "Local"
      }
    },
    "Commands": {
      "demo-local-start": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["start"]
      },
      "demo-local-stop": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["stop"]
      },
      "demo-local-restart": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["restart"]
      },
      "demo-local-status": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["status"]
      },
      "demo-local-console": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["command", "--"]
      },
      "demo-local-logs": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-control.sh",
        "Arguments": ["logs"]
      },
      "demo-local-metrics": {
        "Target": "demo-local-host",
        "Command": "%WorkspacePath%/Server/Development/server-metrics.sh",
        "Arguments": []
      },
      "demo-local-server-files": {
        "Target": "demo-local-host",
        "Command": "python3",
        "Arguments": ["%WorkspacePath%/Server/Development/file-manager.py", "server", "%WorkspacePath%/Server/Development/Server"]
      },
      "demo-local-data-files": {
        "Target": "demo-local-host",
        "Command": "python3",
        "Arguments": ["%WorkspacePath%/Server/Development/file-manager.py", "data", "%WorkspacePath%/Server/Development/Data"]
      }
    }
  },
  "Servers": {
    "Instances": [
      {
        "Id": "demo-local",
        "Name": "Alegacy Local Server",
        "Host": "localhost",
        "Port": 42420,
        "Location": "Local development",
        "StartOperation": "demo-local-start",
        "StopOperation": "demo-local-stop",
        "RestartOperation": "demo-local-restart",
        "StatusOperation": "demo-local-status",
        "ConsoleOperation": "demo-local-console",
        "LogsOperation": "demo-local-logs",
        "MetricsOperation": "demo-local-metrics"
      }
    ]
  },
  "FileManager": {
    "MaximumFileSizeBytes": 52428800,
    "MaximumArchiveSizeBytes": 52428800,
    "MaximumListingEntries": 2000,
    "MaximumConcurrentOperations": 2,
    "Instances": {
      "demo-local": {
        "Roots": {
          "server": {
            "DisplayName": "Server",
            "Path": "%WorkspacePath%/Server/Development/Server",
            "Operation": "demo-local-server-files",
            "IsWritable": false
          },
          "data": {
            "DisplayName": "Data",
            "Path": "%WorkspacePath%/Server/Development/Data",
            "Operation": "demo-local-data-files",
            "IsWritable": true
          }
        }
      }
    }
  },
  "LogStore": {
    "MinimumLevel": "Debug",
    "MaximumRetainedDays": 7
  }
}
