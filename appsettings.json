{
  "WorkspacePath": "/data/Development/AlegacyVS/AlegacyWebPanel",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/alegacy/data/alegacy.db"
  },
  "Authentication": {
    "CookieName": "alegacy.auth",
    "CookieLifetimeHours": 8,
    "SlidingExpiration": true,
    "LoginLog": {
      "MaxRetainedDays": 90
    },
    "Admin": {
      "Username": "admin",
      "PasswordFile": "/run/secrets/admin_password"
    }
  },
  "DataProtection": {
    "KeysPath": "/var/lib/alegacy/keys"
  },
  "Remote": {
    "Targets": {},
    "Commands": {}
  },
  "Servers": {
    "MaximumCommandLength": 512,
    "Instances": []
  },
  "LogStore": {
    "DatabasePath": "/var/lib/alegacy/data/logs.db",
    "MinimumLevel": "Information",
    "MaximumRetainedDays": 30,
    "MaximumRetainedEntries": 500000,
    "BufferCapacity": 4096,
    "FlushBatchSize": 100,
    "PruneIntervalMinutes": 60,
    "StructuredStateMaxBytes": 4096
  }
}
